# MEOCE API — environment variables
# Copy to .env and fill in real values. .env is never committed.

MEOCE_ENV=dev
API_VERSION=0.2.0

# Staging database (Coolify service "dbmeoce-staging", port published on 127.0.0.1 only)
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5433
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
